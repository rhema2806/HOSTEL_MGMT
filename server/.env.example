# Server
PORT=5000
NODE_ENV=development

# MongoDB - local:  mongodb://127.0.0.1:27017/hostel_mess
#           atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hostel_mess
MONGODB_URI=mongodb://127.0.0.1:27017/hostel_mess

# Generate a long random value, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# Used to decide what "today" means for menus and attendance
APP_TIMEZONE=Asia/Kolkata
